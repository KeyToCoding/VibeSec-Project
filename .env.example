# ===================================================
# VibeSec Express Gateway & Fullstack Environment Variables
# ===================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# FastAPI Backend Service URL
# Local Development: http://127.0.0.1:8000
# Production on Render: https://vibesec-backend.onrender.com
FASTAPI_URL=https://vibesec-backend.onrender.com

# Shared internal token between Express and FastAPI
# Generate a high-entropy secret (e.g. openssl rand -hex 32)
FASTAPI_INTERNAL_TOKEN=your-random-internal-secret-token-here

# Allowed Frontend Origins for strict CORS (comma-separated)
# Example: https://your-site.netlify.app,http://localhost:3000
ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# Vite Frontend API Base URL (used by Netlify build)
# Set to your deployed Render Express API URL:
VITE_API_BASE_URL=https://vibesec-api.onrender.com

# Cryptographic Session Secret for Scan History Isolation
# Set to a high-entropy secret string in production to prevent session tampering.
# Must match the SESSION_SECRET in FastAPI backend.
SESSION_SECRET=your-random-32-byte-session-secret-here

# Optional: GitHub Personal Access Token (PAT) for backend repository scanning
# Increases GitHub API rate limit from 60 req/hr (unauthenticated) to 5,000 req/hr.
# Never expose this token in React, browser requests, or logs.
GITHUB_TOKEN=
 
# Optional: Google Gemini API Configuration (Not required for zero-cost deployment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
