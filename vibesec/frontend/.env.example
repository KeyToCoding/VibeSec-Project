# ===================================================
# VibeSec Frontend Environment Variables (Netlify / Vite)
# ===================================================

# Base URL of your deployed Express API Gateway on Render
# Netlify will build your SPA with this endpoint configured.
# Do not include a trailing slash.
# Example: https://vibesec-api.onrender.com
VITE_API_BASE_URL=https://vibesec-api.onrender.com
