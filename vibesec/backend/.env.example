# ===================================================
# VibeSec FastAPI Backend Service Environment Variables
# ===================================================

# Service Port (Render sets this dynamically via $PORT)
PORT=8000

# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Internal Authentication Token
# Must match the FASTAPI_INTERNAL_TOKEN set in the Express service
FASTAPI_INTERNAL_TOKEN=your-random-internal-secret-token-here

# AI Provider Preference: 'gemini' for production, 'ollama' for local development
AI_PROVIDER=gemini

# Production AI: Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Local Development AI: Ollama
# Default local host: http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional Remote Colab / ngrok tunnel URL
COLAB_NGROK_URL=

# Optional Groq API Key (Secondary fallback)
GROQ_API_KEY=

# Database URI (Optional - falls back to in-memory database automatically if offline)
MONGODB_URI=mongodb://localhost:27017/vibesec

# Cryptographic Session Secret for Scan History Isolation
# Set to a high-entropy secret string in production to prevent session tampering
SESSION_SECRET=your-random-32-byte-session-secret-here
