# ===================================================
# VibeSec FastAPI Backend Service Environment Variables
# ===================================================

# Service Port (Render sets this dynamically via $PORT)
PORT=8000

# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Internal Authentication Token
# Must match the FASTAPI_INTERNAL_TOKEN set in the Express service
FASTAPI_INTERNAL_TOKEN=your-random-internal-secret-token-here

# AI Provider Preference: 'ollama' for zero-cost production & local dev (default)
# Set to 'gemini' only if an optional Gemini API key is configured.
AI_PROVIDER=ollama

# Production & Development AI: Ollama (Zero-Cost, No Paid API Required)
# Local Development: http://127.0.0.1:11434
# Production via Cloudflare Quick Tunnel: https://<random-id>.trycloudflare.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama Proxy Authentication Token
# Required when connecting FastAPI on Render to your local Windows Ollama proxy via Cloudflare Tunnel.
# Generate a strong token (e.g., openssl rand -hex 32)
# NEVER expose this token to frontend JavaScript or client-side code.
OLLAMA_PROXY_TOKEN=your-strong-ollama-proxy-token-here

# Optional: Google Gemini API (Optional fallback only if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Remote Colab / ngrok tunnel URL
COLAB_NGROK_URL=

# Optional Groq API Key (Secondary fallback)
GROQ_API_KEY=

# Database URI (Optional - falls back to in-memory database automatically if offline)
MONGODB_URI=mongodb://localhost:27017/vibesec

# Cryptographic Session Secret for Scan History Isolation
# Set to a high-entropy secret string in production to prevent session tampering
SESSION_SECRET=your-random-32-byte-session-secret-here
